{
  "name": "invofin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/risk/*.test.ts lib/auth/*.test.ts lib/documents/*.test.ts lib/funding/*.test.ts lib/*.test.ts modules/dashboard/*.test.ts",
    "test:db": "tsx --test tests/database.test.ts",
    "test:local": "node --env-file=.env.test.local node_modules/tsx/dist/cli.mjs --test tests/local-stack.test.ts",
    "test:auth:local": "node --env-file=.env.test.local node_modules/tsx/dist/cli.mjs --test tests/auth-local.test.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "dev:local": "node scripts/run-local.mjs",
    "worker:local": "node scripts/run-local.mjs --worker",
    "eval:ocr": "tsx --env-file=.env.local scripts/evaluate-ocr.ts",
    "eval:screening": "tsx scripts/evaluate-screening.ts",
    "worker": "node --env-file=.env.local scripts/run-document-worker.mjs",
    "seed": "tsx --env-file=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
