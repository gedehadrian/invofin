NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=prototype
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Set manual for isolated UI/integration tests; leave empty to use configured Azure.
INVOFIN_OCR_MODE=
# Random server-only bearer secret, at least 32 characters. Never prefix with NEXT_PUBLIC_.
CRON_SECRET=
# Endpoint invoked by npm run worker; defaults to http://127.0.0.1:3100
WORKER_BASE_URL=http://127.0.0.1:3100
